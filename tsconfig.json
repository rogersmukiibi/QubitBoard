{
    "compilerOptions": {
        "target": "ES2015",
        "module": "ES2015",
        "moduleResolution": "bundler",
        "lib": ["ES2017", "DOM"],
        "strict": true,
        "allowJs": true,
        "checkJs": false,
        "skipLibCheck": true,
        "isolatedModules": true,
        "noEmit": true
    },
    "include": ["src/**/*.ts", "test/**/*.ts", "test_perf/**/*.ts"]
}
