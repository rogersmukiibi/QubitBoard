{
  "name": "qubitboard",
  "title": "QubitBoard",
  "description": "A drag-and-drop toy for exploring and understanding small quantum circuits.",
  "license": "Apache-2.0",
  "version": "2.5.0",
  "homepage": "https://rogersmukiibi.com/QubitBoard/",
  "bugs": {
    "url": "https://github.com/rogersmukiibi/QubitBoard/issues"
  },
  "devDependencies": {
    "esbuild": "~0.28.2",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-firefox-launcher": "~2.1.3",
    "puppeteer": "^25.12.0",
    "typescript": "~7.0.2",
    "vitepress": "2.0.0-alpha.20"
  },
  "scripts": {
    "build": "node build.mjs app",
    "build-debug": "node build.mjs app-debug",
    "build-test-page": "node build.mjs test",
    "build-test-perf-page": "node build.mjs test-perf",
    "build-docs": "vitepress build doc",
    "serve-docs": "vitepress dev doc",
    "screenshot-gates": "node --experimental-strip-types PuppeteerScreenshotGates.mts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node build.mjs test && node PuppeteerRunTests.js",
    "test-chrome": "node build.mjs test && karma start karma.test.conf.js --browsers Chrome",
    "test-firefox": "node build.mjs test && karma start karma.test.conf.js --browsers Firefox",
    "test-perf-chrome": "node build.mjs test-perf && karma start karma.test_perf.conf.js --browsers Chrome"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rogersmukiibi/QubitBoard.git"
  }
}
